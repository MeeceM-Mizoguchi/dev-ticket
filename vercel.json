{
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/github/sync-released", "schedule": "*/15 * * * *" }
  ],
  "functions": {
    "api/github/[resource].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/dav/:path*", "destination": "/api/dav-open?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/build-info.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
